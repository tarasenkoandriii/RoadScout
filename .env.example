# Copy to .env before running `docker compose up` to override defaults.
GOOGLE_GEOCODING_API_KEY=
PARSER_CRON_SECRET=local-dev-secret
# Глава 16–18: shared secret for POST /internal/fixed-route/:cameraId/live-position (LIVE_GPS carrier feed ingestion)
LIVE_GPS_SECRET=local-dev-live-gps-secret

# --- Прокси ("VPN") для сканирования внешних реестров камер — опционально, портировано из
# cargo-tracker. Если не задано, парсер сканирует напрямую (поведение по умолчанию не меняется).
# Если прокси задан, но недоступен в момент запроса — парсер сам откатывается на прямой запрос
# ("VPN не подключён"), см. apps/api/src/scraper/proxy/registry-proxy.service.ts.
REGISTRY_SCAN_PROXY_URL=
# Либо удобные Webshare-переменные вместо готового URL (см. apps/api/.env.example):
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_COUNTRY=

# --- "Мой дом": авто-верификация адреса по квитанции — опционально, без ключа заявки уходят
# на ручное ревью админом (см. apps/api/.env.example для деталей).
XAI_API_KEY=
GROK_VISION_MODEL=grok-4
HOME_VERIFICATION_MIN_CONFIDENCE=0.7
HOME_VERIFICATION_RATE_LIMIT_MAX=3
HOME_VERIFICATION_RATE_LIMIT_WINDOW_HOURS=24
# Object storage для фото квитанций (Vercel Blob) — без токена откат на data:-URL в БД, как раньше.
BLOB_READ_WRITE_TOKEN=

# Telegram auth (see apps/api/.env.example / apps/admin/.env.example for details)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_IDS=
# "Рабочее место блогера" — отдельный allowlist, зеркалит ADMIN_TELEGRAM_IDS (см. BloggerGuard).
BLOGGER_TELEGRAM_IDS=
JWT_SECRET=local-dev-jwt-secret

# --- Локальная отладка: авто-вход во все рабочие места (admin/blogger/client) ---
# Включено по умолчанию в docker-compose.yml. Поставьте DEV_AUTO_LOGIN=false здесь, чтобы
# выключить (например, если хотите тестировать реальный Telegram Login Widget в докере).
# НИКОГДА не включайте это в проде — .env/docker-compose.yml не используются при деплое на
# Vercel, так что там эта переменная просто не определена, но если поднимаете API где-то ещё
# (свой сервер, не Vercel) — убедитесь, что DEV_AUTO_LOGIN там не выставлен в "true".
# DEV_AUTO_LOGIN=false
#
# Формат: "role:telegramId:firstName:lastName:username:photoUrl;..." — по одной записи на
# роль (admin|blogger|client), разделены ';'. lastName/username/photoUrl можно оставлять
# пустыми. См. src/auth/dev-accounts.util.ts.
# DEV_MOCK_ACCOUNTS=admin:900000001:Админ:Тестовый:admin_dev:;blogger:900000002:Блогер:Тестовый:blogger_dev:;client:900000003:Клиент:Тестовый:client_dev:
