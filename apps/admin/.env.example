# Bot username WITHOUT the @, e.g. "roadscout_bot" — must match the bot whose token
# is set as TELEGRAM_BOT_TOKEN in apps/api/.env. Exposed to the browser (NEXT_PUBLIC_)
# because the Telegram Login Widget script needs it client-side; this is not a secret.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Only used server-side by next.config.js rewrites to reach the NestJS API.
NEST_API_URL="http://localhost:3000"
