# --- Database (Supabase) ---
# Pooled connection (PgBouncer, port 6543) — use this one at runtime.
DATABASE_URL="postgresql://user:password@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only by Prisma Migrate.
DIRECT_URL="postgresql://user:password@db.xxxx.supabase.co:5432/postgres"

# --- External APIs ---
# Используется и для Geocoding API (структурированные адреса), и для Places API Text Search
# (GeocodingService.searchPlace() — поиск по ориентирам/POI, см. doc/README.md,
# "AI-автоматизація додавання камер") — на Google Cloud нужно включить ОБА API на этом ключе.
GOOGLE_GEOCODING_API_KEY=""
# GeocodingService.searchPlaceOSM() (OpenStreetMap Nominatim) НЕ требует ключа вообще —
# работает даже если GOOGLE_GEOCODING_API_KEY пуст. См. doc/AUDIT-nominatim-coordinate-helper.md.

# --- Registry-scan proxy ("VPN"), ported from cargo-tracker — optional ---
# Routes the parser's requests to external camera-registry sites (webcam.guru.ua etc, see
# src/scraper/proxy/) through a proxy, in case a site starts blocking the hosting's datacenter
# IP. If unset, the parser just scans directly (default, unchanged behavior). If a proxy IS
# configured but turns out to be unreachable at request time ("VPN не подключён"), the parser
# automatically retries the same request directly instead of failing the whole run — see
# src/scraper/proxy/registry-proxy.service.ts.
#
# Option 1 — full URL, any provider:
# REGISTRY_SCAN_PROXY_URL="http://user:pass@host:port"
#
# Option 2 — Webshare convenience vars (builds a rotating backbone URL automatically):
# WEBSHARE_PROXY_USERNAME=""
# WEBSHARE_PROXY_PASSWORD=""
# WEBSHARE_PROXY_HOST="p.webshare.io"
# WEBSHARE_PROXY_PORT="80"
# WEBSHARE_PROXY_COUNTRY=""
# WEBSHARE_PROXY_ROTATE="true"
#
# Option 3 — the conventional HTTPS_PROXY / HTTP_PROXY (picked up automatically if already set).

# --- "Мой дом": авто-верификация адреса по квитанции (AI vision, опционально) ---
# Без ключа заявки всегда уходят на ручное ревью админом (никогда не авто-одобряются вслепую).
# xAI (Grok) — тот же провайдер, что и в cargo-tracker.
XAI_API_KEY=""
XAI_BASE_URL="https://api.x.ai/v1"
GROK_VISION_MODEL="grok-4"
# --- AI-автоматизация этапов добавления камеры (GrokCameraAssistService, см.
# doc/README.md, "Камери всередині приміщень") — та же пара ключей XAI_API_KEY/GROK_API_KEY
# выше, отдельная модель для текстовых (не vision) запросов. AI вызывается ТОЛЬКО по запросу
# админа на этапе ручного ревью (кнопка "Спросить AI") — не автоматически в парсере/при
# подаче краудсорс-заявки (см. doc/AUDIT-ai-assist-manual-review-only.md). ЕДИНСТВЕННОЕ
# осознанное исключение — YoutubeSearchAdapter.isRelevant() (см.
# doc/TZ-youtube-camera-discovery.md, П3): текстовый поиск даёт много шума, без AI-фильтра
# очередь ревью захлебнётся нерелевантными результатами — тот же GROK_TEXT_MODEL используется.
GROK_TEXT_MODEL="grok-4"

# --- YouTube-пошук камер (YoutubeSearchAdapter, см. doc/TZ-youtube-camera-discovery.md) —
# ОКРЕМИЙ ключ Google Cloud (YouTube Data API v3 треба включити окремо від Places/Geocoding).
YOUTUBE_DATA_API_KEY=""
YOUTUBE_SEARCH_RADIUS_KM="25"
YOUTUBE_SEARCH_MAX_RESULTS="50"

# --- Пошук окремих камер через Google (веб-пошук Grok, див. doc/AUDIT-google-web-search-cameras.md)
# — той самий XAI_API_KEY/GROK_API_KEY вище, окрема reasoning-модель для /v1/responses +
# web_search tool. Google Custom Search JSON API закритий для нових клієнтів з 2025 — це
# заміна, що не потребує окремого ключа взагалі.
GROK_WEB_SEARCH_MODEL="grok-4"
WEB_SEARCH_PAGE_FETCH_MAX_BYTES="500000"

# --- Windy Webcams API (WindyWebcamsAdapter, див. doc/AUDIT-windy-webcams-and-nature-cameras.md)
# — окремий безкоштовний ключ, отримати на https://api.windy.com/webcams/docs.
WINDY_WEBCAMS_API_KEY=""
WINDY_SEARCH_RADIUS_KM="25"
WINDY_MAX_RESULTS="50"

# --- NYC DOT Traffic Cameras (NycTmcAdapter, adapterKey: "nyctmc") — реальний, безкоштовний
# публічний API без ключа (webcams.nyctmc.org/api/cameras), знайдений і підтверджений
# користувачем напряму. Жодних env-змінних не потрібно.

# --- 511NY API (FiveElevenNyService, src/situational/five11ny.service.ts) — офіційний,
# безкоштовний API NYSDOT для дорожніх подій штату Нью-Йорк. За прямим запитом користувача —
# основне джерело прогнозу трафіку для BTW-планування маршрутів (doc/TZ-btw-route-planning.md,
# §7.2), замінило раніше заплановану роботу над oktraffic.org. Отримати ключ:
# https://511ny.org/developers/help (Developer's Access Request Form, безкоштовно, ліміт 10
# запитів/60с). Без ключа сервіс просто повертає порожній список подій (логує попередження) —
# так само, як GOOGLE_GEOCODING_API_KEY вище.
FIVE11NY_API_KEY=""

# --- TomTom Traffic Incidents API (TomTomTrafficService, src/situational/tomtom.service.ts) —
# fallback/дополнение вне NY State (doc/TZ-btw-route-planning.md §7.2/§9 п.5, за прямим запитом
# користувача). Безкоштовний тариф — 2500 запитів/міс на Incidents (класичний v5, НЕ Orbis).
# Отримати ключ: https://developer.tomtom.com (реєстрація акаунту розробника, без картки).
# Без ключа сервіс повертає порожній список (той самий паттерн, що FIVE11NY_API_KEY вище).
TOMTOM_API_KEY=""

# --- OpenRouteService Directions API (OpenRouteServiceClient, src/routing/
# openrouteservice.service.ts) — побудова маршруту А->Б для BTW (doc/TZ-btw-route-planning.md
# §6.1/§6.3), за прямим запитом користувача. Безкоштовний тариф — 2000 запитів/день, 40/хв.
# Отримати ключ: https://openrouteservice.org/dev/#/signup (реєстрація, безкоштовно). Без ключа
# POST /btw/route повертає 503 з чесним поясненням (не 500 і не мовчазну заглушку) — той самий
# принцип, що FIVE11NY_API_KEY/TOMTOM_API_KEY вище, лише не-опційний для цього конкретного
# ендпоінту (без ключа побудова маршруту в принципі неможлива, на відміну від "просто немає
# додаткових даних про трафік").
OPENROUTESERVICE_API_KEY=""

# --- Камеры внутри помещений (Camera.locationType) — радиус "рядом с адресом", в котором
# такую камеру ещё показываем как "также поблизости" (см. CamerasService.findIndoorNearby).
INDOOR_CAMERA_NEARBY_RADIUS_METERS="500"
# true (по умолчанию) — рукописная дата должна быть не старше 3 дней; false — до 14 дней (мягче,
# на случай если пользователи стабильно не успевают отправить заявку в тот же день).
HOME_VERIFICATION_STRICT_DATE="true"
# Калибровка порога уверенности совпадения адреса для авто-одобрения (0.0-1.0). Подбирайте по
# факту первых реальных заявок — см. GET /admin/home-verifications/stats (распределение
# confidence по итоговому решению админа помогает понять, не завышен/занижен ли порог).
HOME_VERIFICATION_MIN_CONFIDENCE="0.7"
# Rate-limiting заявок по IP — защита от накрутки платных AI-вызовов спамом. Без BLOB/прокси это
# не сработает надёжно локально (см. getClientIp() в контроллере — читает x-forwarded-for).
HOME_VERIFICATION_RATE_LIMIT_MAX="3"
HOME_VERIFICATION_RATE_LIMIT_WINDOW_HOURS="24"

# --- Час очікування на кордоні (краудсорс, src/border-crossings) ---
BORDER_WAIT_ESTIMATE_WINDOW_HOURS="3"
BORDER_REPORT_RATE_LIMIT_MAX="10"
BORDER_REPORT_RATE_LIMIT_WINDOW_HOURS="1"

# --- Підписки-алерти (src/alerts) — доставка через той самий TELEGRAM_BOT_TOKEN, окремий
# ключ не потрібен. Скільки хвилин "назад" дивитись на нові інциденти при першому тику для
# щойно створеної AREA_INCIDENT-підписки.
ALERTS_INCIDENT_LOOKBACK_MINUTES="60"

# --- Краудсорс "Додати камеру" (src/camera-submissions) ---
CAMERA_SUBMISSION_RATE_LIMIT_MAX="5"
CAMERA_SUBMISSION_RATE_LIMIT_WINDOW_HOURS="24"

# --- Детальный журнал импорта (src/scraper/import-log.service.ts, см.
# doc/TZ-parser-import-improvements.md, П1.2) — сколько дней хранить пошаговые записи лога
# перед автоочисткой (не влияет на агрегированную статистику ParserRunLog, та не чистится).
IMPORT_LOG_RETENTION_DAYS="30"

# --- Эвристика азимута (src/scraper/azimuth-heuristic.service.ts, см.
# doc/TZ-parser-import-improvements.md, П2.1) ---
AZIMUTH_HEURISTIC_CACHE_TTL_HOURS="24"
AZIMUTH_HEURISTIC_TIMEOUT_MS="8000"

# --- Кеш перевірки видимості будівель (src/occlusion/occlusion.service.ts) — за прямим
# запитом користувача, аудит сумісності з Vercel Hobby (doc/AUDIT-vercel-hobby.md): раніше
# кожен виклик isPossiblyBlocked() бив Overpass наново; BTW викликає його 9 разів на кожного
# кандидата-камеру на кожен тик сканування (~2с) — десятки некешованих запитів на тик.
OCCLUSION_CACHE_TTL_HOURS="24"

# --- Health-сигнал по источнику (П2.3) — сколько последних успешных проходов брать для
# скользящего среднего, минимум для срабатывания (не поднимать тревогу на первых проходах),
# и порог отклонения (0.5 = 50%).
PARSER_ANOMALY_HISTORY_SIZE="5"
PARSER_ANOMALY_MIN_HISTORY="3"
PARSER_ANOMALY_THRESHOLD="0.5"

# --- Охват всех городов (П2.2) — задержка между источниками при /internal/parser/run-all,
# чтобы не долбить внешний сайт-источник параллельно по всем городам разом.
PARSER_RUN_ALL_DELAY_MS="2000"

# --- Бюджет времени на один проход (П3.2) — защита от таймаута serverless-функции при большом
# каталоге; проход аккуратно останавливается и явно логирует, сколько элементов не успел
# обработать, вместо необъяснимого обрыва посередине.
PARSER_RUN_TIME_BUDGET_MS="25000"

# --- Перевірка доступності контенту камер (MonitoringService.checkContentAvailability, див.
# doc/AUDIT-camera-content-availability.md) — окремо від парсера/автоімпорту, тільки
# YouTube-камери, YouTube oEmbed + AI vision-резерв (той самий GROK_VISION_MODEL).
CONTENT_CHECK_TIME_BUDGET_MS="25000"
CONTENT_CHECK_DELAY_MS="500"

# --- WebcamGuruAdapter (П0.1 — подтверждено реальным HTML) — сайт устроен в две фазы: список
# камер города (быстрый, один запрос), затем отдельный запрос на КАЖДУЮ страницу камеры за
# ссылкой на поток (см. ProviderAdapter.fetchDetails, вызывается из ScraperService под уже
# существующим бюджетом времени прохода — не изнутри discover(), см.
# doc/AUDIT-webcam-guru-real-html.md о реальном инциденте, из-за которого это так сделано).
# Задержка между этими дозапросами — вежливость по отношению к сайту-источнику.
PARSER_DETAIL_FETCH_DELAY_MS="300"

# --- Конкурентність обробки елементів (див. doc/AUDIT-nyctmc-performance.md — реальний
# знайдений інцидент: NYC TMC повертає ~900-969 камер одним викликом, але оброблялись
# ПОСЛІДОВНО, з реальним мережевим викликом до Overpass API на кожну — за замовчуванням
# використовується ЛИШЕ для адаптерів БЕЗ fetchDetails() (webcam.guru.ua й аналогічні
# двофазні адаптери завжди залишаються послідовними — 1, ввічливість до сайту-джерела).
PARSER_ITEM_CONCURRENCY="8"

# --- Батчування Overpass-запитів (AzimuthHeuristicService.guessForPoints() — див.
# doc/AUDIT-overpass-batching.md) — скільки координат обʼєднується в ОДИН HTTP-запит до
# Overpass API замість окремого запиту на кожну.
OVERPASS_BATCH_SIZE="20"

# Поріг впевненості AI (0..1) для автоматичного промоушну ESTIMATED -> VERIFIED при
# автокалібруванні (див. doc/AUDIT-auto-calibrate-batch.md) — за прямим запитом користувача
# знижено з рівно 100% (нереалістичний поріг — реальні відповіді моделі рідко його сягають).
AI_CALIBRATION_CONFIDENCE_THRESHOLD="0.7"

# --- Object storage для фото квитанций (Vercel Blob, публичный доступ) ---
# Без токена сервис откатывается на data:-URL прямо в БД (как раньше) — см.
# src/home-verification/receipt-storage.service.ts. Получить токен: Vercel Dashboard -> Storage
# -> Blob -> Create Store, либо `vercel blob store add` в CLI после `vercel link`.
BLOB_READ_WRITE_TOKEN=""

# --- Telegram auth ---
# Bot token from @BotFather. Also used to verify Telegram Login Widget payloads.
TELEGRAM_BOT_TOKEN=""
# Comma-separated Telegram numeric user IDs allowed into the admin panel.
# Get your own ID from @userinfobot.
ADMIN_TELEGRAM_IDS=""
# Comma-separated Telegram numeric user IDs allowed into the blogger workplace (BloggerGuard).
# Admins are always allowed in too, regardless of this list.
BLOGGER_TELEGRAM_IDS=""
# Signs the session JWT — generate with `openssl rand -hex 32`. Required in production.
JWT_SECRET="change-me"

# --- Local debug: instant login into every workplace (admin/blogger/client) ---
# See src/auth/dev-accounts.util.ts. NEVER set DEV_AUTO_LOGIN=true outside local dev — it lets
# anyone log in as any of the roles below with a single unauthenticated POST /auth/dev-login.
# Той самий прапорець тепер ще й вмикає BTW-дебаг "подмена координат" (/admin/btw-dev-tools,
# doc/AUDIT-btw.md) — та сама причина: обидва інструменти виключно для локальної/staging-
# відладки, обидва мають бути повністю недоступні (404) в продакшені.
DEV_AUTO_LOGIN="false"
# One entry per role, separated by ';'. Fields within an entry separated by ':':
# role:telegramId:firstName:lastName:username:photoUrl (lastName/username/photoUrl optional).
DEV_MOCK_ACCOUNTS="admin:900000001:Admin:Dev:admin_dev:;blogger:900000002:Blogger:Dev:blogger_dev:;client:900000003:Client:Dev:client_dev:"

# --- Internal auth ---
# Shared secret Supabase pg_cron sends in the x-cron-secret header (see sql/pg_cron-schedule.sql).
PARSER_CRON_SECRET="change-me"

# --- CORS ---
ADMIN_ORIGIN="http://localhost:3001"
# ДОДАНО (doc/TZ-btw-landing-v2.md §4) — список дозволених origin через кому. Якщо не
# задано — фолбек на ADMIN_ORIGIN вище (зворотна сумісність). Додайте сюди origin нового
# лендингу apps/interactive (локально — http://localhost:3004, на проді — реальний домен
# деплою), інакше браузер заблокує запити до /btw/landing-snapshot через CORS.
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3004"

PORT=3000
