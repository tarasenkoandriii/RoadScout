{
  "multipass": true,
  "js2svg": { "indent": 2, "pretty": true },
  "plugins": [
    {
      "name": "preset-default",
      "params": {
        "overrides": {
          "removeViewBox": false,
          "cleanupIds": false,
          "removeUselessDefs": false,
          "removeUnknownsAndDefaults": {
            "keepAriaAttrs": true,
            "keepRoleAttr": true
          },
          "convertPathData": {
            "floatPrecision": 2
          }
        }
      }
    },
    "removeDimensions",
    "sortAttrs",
    {
      "name": "removeAttrs",
      "params": {
        "attrs": ["data-name", "xmlns:.*"],
        "elemSeparator": ":"
      }
    }
  ]
}
