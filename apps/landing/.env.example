# --- Beyond the Wall — лендинг (apps/landing) ---
# Реальний URL деплою — використовується в metadata (OG/canonical), robots.txt, sitemap.xml.
# NEXT_PUBLIC_ — вшивається в JS-бандл під час збірки (Next.js), тому після зміни
# ОБОВ'ЯЗКОВО потрібен новий деплой, просте збереження змінної в дашборді не застосує її
# (той самий принцип, що вже задокументований для apps/admin, doc/AUDIT-vercel-hobby.md).
NEXT_PUBLIC_SITE_URL="https://btw.example.com"

# Deep-ссылка на сам мини-апп BTW — повна ціль кнопки "Открыть в Telegram", формат
# https://t.me/<bot_username>/<app_short_name> (short_name налаштовується через
# BotFather → /newapp для відповідного бота).
NEXT_PUBLIC_TELEGRAM_MINIAPP_URL="https://t.me/RoadScoutBot/beyondthewall"
