# --- Beyond the Wall — интерактивный лендинг для велосипедистов/автомобилистов (apps/interactive) ---
# Реальный URL деплою — используется в metadata (OG/canonical), robots.txt, sitemap.xml.
# NEXT_PUBLIC_ — вшивается в JS-бандл во время сборки (Next.js), поэтому после изменения
# ОБЯЗАТЕЛЕН новый деплой — тот же принцип, что уже задокументирован для apps/landing.
NEXT_PUBLIC_SITE_URL="https://interactive.btw.example.com"

# Deep-ссылка на сам мини-апп BTW — полная цель кнопки "Открыть в Telegram", формат
# https://t.me/<bot_username>/<app_short_name>.
NEXT_PUBLIC_TELEGRAM_MINIAPP_URL="https://t.me/RoadScoutBot/beyondthewall"

# ДОБАВЛЕНО (doc/TZ-btw-landing-v2.md §3/§4) — в отличие от apps/landing (сознательно без
# бэкенда), этот лендинг ходит в apps/api за живым виджетом "что у вас в городе" (погода +
# 511NY/TomTom инциденты, GET /btw/landing-snapshot). Без trailing slash.
NEXT_PUBLIC_API_URL="http://localhost:3000"
